# Copy to .env and adjust as needed. All variables are prefixed AI_ENGINE_.

AI_ENGINE_ENVIRONMENT=development

# Model gateway — any OpenAI-compatible chat endpoint. The defaults below target
# a local Ollama instance (offline, no key needed). To develop against a hosted
# provider, point these at it; Groq is a good free choice because it serves the
# same open models we'd self-host later (Llama 3, Whisper).
AI_ENGINE_LLM_BASE_URL=http://localhost:11434/v1
AI_ENGINE_LLM_API_KEY=ollama
AI_ENGINE_LLM_MODEL=llama3.2:3b
AI_ENGINE_LLM_PROVIDER=ollama

# Example — hosted via Groq (free; create a key at https://console.groq.com/keys):
# AI_ENGINE_LLM_BASE_URL=https://api.groq.com/openai/v1
# AI_ENGINE_LLM_API_KEY=gsk_your_key_here
# AI_ENGINE_LLM_MODEL=llama-3.1-8b-instant
# AI_ENGINE_LLM_PROVIDER=groq

# Generation tuning. The request timeout is generous (generation is slow); a low
# temperature keeps output faithful to the source. max_source_chars bounds how
# much text is sent to the model per request.
AI_ENGINE_LLM_REQUEST_TIMEOUT=120
AI_ENGINE_LLM_TEMPERATURE=0.2
AI_ENGINE_MAX_SOURCE_CHARS=24000

# Speech-to-text gateway (Module C, transcription). Same OpenAI-compatible shape
# as the model gateway, on /audio/transcriptions. Unlike text, Ollama does not
# serve audio, so there is no offline default that works out of the box —
# transcription needs a hosted STT provider (Groq serves whisper-large-v3) or a
# local faster-whisper (ADR-0007). The defaults below are placeholders; point
# them at a real provider to transcribe.
AI_ENGINE_STT_BASE_URL=http://localhost:11434/v1
AI_ENGINE_STT_API_KEY=ollama
AI_ENGINE_STT_MODEL=whisper-large-v3
AI_ENGINE_STT_PROVIDER=ollama
# Optional ISO-639-1 language hint (e.g. en); leave unset to auto-detect.
# AI_ENGINE_STT_LANGUAGE=en
AI_ENGINE_STT_REQUEST_TIMEOUT=300

# Example — hosted via Groq (serves whisper-large-v3 on the same key as text):
# AI_ENGINE_STT_BASE_URL=https://api.groq.com/openai/v1
# AI_ENGINE_STT_API_KEY=gsk_your_key_here
# AI_ENGINE_STT_PROVIDER=groq

# Upload ceilings. Both are enforced from the Content-Length header before the
# body reaches disk, so an oversized request is refused rather than buffered.
# The audio ceiling is separate because Groq's free tier caps at 25 MiB.
AI_ENGINE_MAX_UPLOAD_BYTES=26214400
AI_ENGINE_MAX_AUDIO_BYTES=26214400
