# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Build artifacts. `python -m build` stages a full copy of the package under
# build/lib, which is a duplicate of the source tree — committed by accident it
# reads as 50% duplicated code, and it goes stale the moment anything changes.
build/
dist/

# Local config & artifacts
.env
*.log

# OS
.DS_Store

# Coverage artefacts. The root .gitignore has `/coverage`, which is anchored to
# the repository root and does not reach these.
.coverage
.coverage.*
coverage.xml
htmlcov/
