# `npm install` fails with ERESOLVE because eslint-config-next@14.2.16 declares a
# peer range of eslint "^7.23.0 || ^8", while this workspace uses eslint 9
# (its flat `eslint.config.js` is the eslint 9 default). Enabling legacy-peer-deps
# lets install resolve without downgrading eslint. See issue #21.
legacy-peer-deps=true
